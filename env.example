STATE_DIR=/data
INITIAL_EQUITY=100

# paper | bybit_testnet
EXECUTION_MODE=paper
TRADING_TIMEFRAME=1h

AUTO_DECISION=false
AUTO_PAPER_EXECUTION=true

NEWS_POLL_SECONDS=20
POSITION_POLL_SECONDS=10
DECISION_INTERVAL_SECONDS=300
STALE_MARKET_SECONDS=180
COOLDOWN_SECONDS=900

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_PROMPT_ID=
OPENAI_REASONING_EFFORT=medium

MARKETTWITS_URL=https://t.me/s/markettwits

# Bybit Testnet only. Keep these as secrets, never commit real values.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_CATEGORY=linear
BYBIT_POSITION_IDX=0

# Telegram bot notifications
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
